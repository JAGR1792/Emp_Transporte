{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.js",
    "css": "src/index.css",
    "baseColor": "slate",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/views/components",
    "utils": "@/utils",
    "ui": "@/views/components/ui",
    "lib": "@/utils",
    "hooks": "@/controllers/hooks"
  },
  "iconLibrary": "lucide",
  "registries": {
    "reactbits": {
      "url": "https://pro.reactbits.dev/r",
      "headers": {
        "Authorization": "Bearer $REACTBITS_LICENSE_KEY"
      }
    }
  }
}
